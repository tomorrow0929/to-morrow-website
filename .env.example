# このファイルをコピーして .env という名前で保存すると、
# 既定値を上書きできます。.env は .gitignore に入れてあるのでGitには上がりません。
#
# ふだんは設定不要です。既定値は src/data/site.js に書いてあります。

# お問い合わせフォームの送信先URL（既定: Formspree）
# 別のサービスに切り替えたいときだけ設定してください。
VITE_CONTACT_ENDPOINT=

# reCAPTCHA v3 のサイトキー（使わない場合は空のままでOK。空ならスクリプトを読み込みません）
VITE_RECAPTCHA_SITE_KEY=
