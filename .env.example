# このファイルをコピーして .env という名前で保存し、値を書き換えてください。
# .env は .gitignore に入れてあるので GitHub には上がりません。

# お問い合わせフォームの送信先URL
# GitHub Pages は静的サイトなので自前の /api/contact は動きません。
# Formspree / Getform / Google Apps Script などのURLを入れてください。
VITE_CONTACT_ENDPOINT=

# reCAPTCHA v3 のサイトキー（使わない場合は空のままでOK。空ならスクリプトを読み込みません）
VITE_RECAPTCHA_SITE_KEY=
